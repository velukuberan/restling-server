POSTGRES_USER=restling
POSTGRES_PASSWORD=replace-with-a-strong-local-password
POSTGRES_DB=restling_dev
# User activation invitations (default: 24 hours)
RESTLING_INVITATION_EXPIRY_HOURS=24
# Trusted externally reachable application URL
# HTTPS required except for local development
RESTLING_PUBLIC_URL=http://localhost:8000
# Optional SMTP invitation delivery
# Leave RESTLING_SMTP_HOST unset for manual invitations.
# RESTLING_SMTP_HOST=localhost
# RESTLING_SMTP_PORT=587
# RESTLING_SMTP_SECURITY=starttls
# RESTLING_SMTP_USERNAME=
# RESTLING_SMTP_PASSWORD=
# RESTLING_SMTP_FROM_EMAIL=restling@example.com
